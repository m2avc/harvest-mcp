# Copy to a local .env (never commit). The harvest-rest stdio server reads these
# from the process environment. Do not put tokens in mcp.json — that file is public.

HARVEST_ACCESS_TOKEN=
HARVEST_ACCOUNT_ID=
# Optional. Default is m2avc-harvest-mcp/<semver> (mn@m2avc.com)
# where <semver> is the repo-root package.json version (Mike-locked).
# Must be the integration author contact, not the end customer's Harvest email.
# HARVEST_USER_AGENT=m2avc-harvest-mcp/0.2.0 (mn@m2avc.com)

# Unlock email send, event_type=send, and payment thank-you email. Default off.
# Requires Mike GO plus per-call confirm_live_send=true and a non-empty go_ref.
# Leave unset for CoS smoke (throwaway draft + payment notes only).
# DANGEROUS_SEND=1

# Force-refuse gated sends even if DANGEROUS_SEND=1. Set for CoS smoke and CI.
# HARVEST_SMOKE=1
# HARVEST_SEND_LOCKOUT=1
